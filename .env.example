# Copy this file to .env and fill in your real keys. Never commit .env.
# Tip: ./install.sh generates this file for you — you rarely need to edit it by hand.

BINANCE_API_KEY=
BINANCE_API_SECRET=

KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# KuCoin, OKX and Bitget also require an API passphrase (chosen when you
# create the key).
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# Other supported exchanges (key + secret only): coinbase, bybit, gate, mexc,
# htx, bitfinex, cryptocom, bingx — same PREFIX_API_KEY / PREFIX_API_SECRET
# pattern. ./install.sh fills these in for you.
